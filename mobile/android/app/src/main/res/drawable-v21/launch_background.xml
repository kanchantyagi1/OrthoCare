<?xml version="1.0" encoding="utf-8"?>
<!-- Pre-Android-12 launch screen: white with the PrimeOrtho mark centred (the
     adaptive-icon foreground, which already carries its own padding). White in
     dark mode too, so it hands over to the (always-light) Flutter splash with
     no flash. Android 12+ uses the system splash - see values-v31. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@android:color/white" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@mipmap/ic_launcher_foreground" />
    </item>
</layer-list>
