NODE_ENV=development
PORT=3001

# --- Database (Postgres + pgvector) ---
# Host port 5433 (not 5432) to avoid colliding with other local Postgres containers - see backend/docker-compose.yml.
DATABASE_URL=postgres://orthocare:orthocare_dev_password@localhost:5433/orthocare

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

# --- OpenAI ---
# Leave blank / "sk-placeholder" to run in mock mode (no network calls, deterministic fake responses).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Document storage ---
# Local disk only (backend/storage/documents/). No S3/AWS dependency.

# --- Firebase Cloud Messaging ---
# Leave blank to run in mock mode (notifications are logged + stored, not actually sent).
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# --- Retention ---
DATA_RETENTION_DAYS=30
DOCUMENT_RETENTION_DAYS=3650

# --- Public patient chat limits ---
# Patients have NO login: they enter a phone number and chat. These endpoints are
# therefore reachable by anyone on the internet, with a paid OpenAI model behind
# them, so these caps are the main defence for the clinic's API bill.
# Buckets are keyed on phone number (session start) / session id (messages), not IP.
PATIENT_SESSION_RATE_LIMIT=5
PATIENT_SESSION_RATE_TTL_MS=3600000
PATIENT_MESSAGE_RATE_LIMIT=12
PATIENT_MESSAGE_RATE_TTL_MS=60000
# Hard stop per phone number per calendar day, regardless of pacing.
PATIENT_DAILY_MESSAGE_CAP=40

# --- Nurse SLA ---
# First response slower than this counts as an SLA breach on the admin dashboard.
NURSE_RESPONSE_SLA_MINUTES=15

# --- RAG ---
RAG_TOP_K=5
# Leave unset to auto-pick: 0.72 (calibrated for real embeddings) when OPENAI_API_KEY is set,
# 0.25 (calibrated for the crude mock embedding) when it's blank/mock mode. Set a value here
# only to override that auto-selection.
RAG_SIMILARITY_THRESHOLD=
