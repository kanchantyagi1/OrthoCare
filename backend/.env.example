NODE_ENV=development
PORT=3001

# --- Database (Postgres + pgvector) ---
# Host port 5433 (not 5432) to avoid colliding with other local Postgres containers - see backend/docker-compose.yml.
DATABASE_URL=postgres://orthocare:orthocare_dev_password@localhost:5433/orthocare

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

# --- OpenAI ---
# Leave blank / "sk-placeholder" to run in mock mode (no network calls, deterministic fake responses).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Document storage ---
# Local disk only (backend/storage/documents/). No S3/AWS dependency.

# --- Firebase Cloud Messaging ---
# Leave blank to run in mock mode (notifications are logged + stored, not actually sent).
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# --- Retention ---
DATA_RETENTION_DAYS=30
DOCUMENT_RETENTION_DAYS=3650

# --- Public patient chat limits ---
# Patients have NO login: they enter a phone number and chat. These endpoints are
# therefore reachable by anyone on the internet, with a paid OpenAI model behind
# them, so these caps are the main defence for the clinic's API bill.
# Buckets are keyed on phone number (session start) / session id (messages), not IP.
PATIENT_SESSION_RATE_LIMIT=5
PATIENT_SESSION_RATE_TTL_MS=3600000
PATIENT_MESSAGE_RATE_LIMIT=12
PATIENT_MESSAGE_RATE_TTL_MS=60000
# Hard stop per phone number per calendar day, regardless of pacing.
PATIENT_DAILY_MESSAGE_CAP=40

# --- Doctor SLA ---
# First response slower than this counts as an SLA breach on the admin dashboard.
DOCTOR_RESPONSE_SLA_MINUTES=15

# --- RAG ---
RAG_TOP_K=5
# Cosine similarity a chunk must reach to be fed to the model. Below it, the assistant is told it has
# no supporting knowledge and escalates to a doctor instead of guessing.
#
# 0.45 was derived empirically against real text-embedding-3-small vectors, NOT guessed: for the
# question "Can I walk after knee replacement surgery?" the demo chunks scored
# 0.60 / 0.56 / 0.47 / 0.43 / 0.32, so clearly on-topic content sits around 0.47-0.67 and the
# irrelevant tail falls below ~0.43. The auto-selected default of 0.72 rejected EVERYTHING, which
# made the assistant escalate every single question and look broken.
#
# Re-tune this once real clinic PDFs replace the demo pack - longer, more varied documents shift
# the distribution. Raise it if the AI starts answering from loosely-related passages (a safety
# risk); lower it if it escalates questions the documents clearly do cover.
# Leave blank to fall back to the built-in auto-selection (0.72 real / 0.25 mock-embedding mode).
RAG_SIMILARITY_THRESHOLD=0.45
